rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidRegistration(data) {
      return data.firstName is string && data.firstName.size() > 0 
          && data.lastName is string && data.lastName.size() > 0
          && data.idNumber is string && data.idNumber.size() > 0
          && data.email is string && data.email.size() > 0
          && data.membershipType in ["Joven", "Adulto"]
          && data.scoutGroup is string;
    }

    match /registrations/{regId} {
      allow create: if isValidRegistration(request.resource.data);
      allow get: if true;
      allow list: if true; 
      allow update: if true;
      allow delete: if true;
    }

    match /payments/{paymentId} {
      allow create: if true; // Allow public reporting of payments
      allow get: if true;
      allow list: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if true; // In production, restrict to Superadmin
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    match /candidates/{candidateId} {
      allow read: if true;
      allow write: if true;
    }

    match /votes_audit/{auditId} {
      allow read: if true;
      allow write: if true;
    }

    match /votes_ballot/{ballotId} {
      allow read: if true;
      allow write: if true;
    }

    match /group_attachments/{attachmentId} {
      allow read: if true;
      allow write: if true;
    }

    match /responses_questionnaire/{responseId} {
      allow read: if true;
      allow write: if true;
    }

    match /news_articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
