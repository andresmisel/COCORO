{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Participant registration for the congress",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "idNumber": { "type": "string" },
        "email": { "type": "string" },
        "membershipType": { "type": "string", "enum": ["Joven", "Adulto"] },
        "scoutGroup": { "type": "string" },
        "bankReference": { "type": "string" },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string" },
        "proofUrl": { "type": "string" },
        "adminStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "opsStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminObservations": { "type": "string" },
        "opsObservations": { "type": "string" },
        "checkedIn": { "type": "boolean" },
        "checkInTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "idNumber", "email", "membershipType", "scoutGroup", "bankReference", "amount", "paymentDate"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment report for a registration",
      "type": "object",
      "properties": {
        "idNumber": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["Transferencia/Pago Movil", "Efectivo"] },
        "bankReference": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "exchangeRate": { "type": "number" },
        "amount": { "type": "number" },
        "amountUSD": { "type": "number" },
        "paymentDate": { "type": "string" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminObservations": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["idNumber", "paymentMethod", "amount", "amountUSD", "paymentDate", "status"]
    },
    "Config": {
      "title": "Global Config",
      "description": "App configuration",
      "type": "object",
      "properties": {
        "bankDetails": { "type": "string" },
        "eventDate": { "type": "string" },
        "eventLocation": { "type": "string" }
      }
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Information about a voting candidate",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "photo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName"]
    },
    "VoteAudit": {
      "title": "Vote Audit",
      "description": "Log of voter identity who cast a ballot to prevent double voting",
      "type": "object",
      "properties": {
        "idNumber": { "type": "string" },
        "name": { "type": "string" },
        "scoutGroup": { "type": "string" },
        "votedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["idNumber", "name", "scoutGroup", "votedAt"]
    },
    "VoteBallot": {
      "title": "Vote Ballot",
      "description": "Secret ballot containing the candidate ID selected by a voter",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string" },
        "votedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["candidateId", "votedAt"]
    },
    "GroupAttachment": {
      "title": "Group Attachment",
      "description": "Document or image uploaded for a scout group",
      "type": "object",
      "properties": {
        "scoutGroup": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileData": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scoutGroup", "fileName", "fileData", "createdAt"]
    },
    "QuestionnaireResponse": {
      "title": "Questionnaire Response",
      "description": "Anonymous event questionnaire evaluation response per scout group",
      "type": "object",
      "properties": {
        "scoutGroup": { "type": "string" },
        "ratingSchedule": { "type": "number" },
        "ratingFood": { "type": "number" },
        "ratingCocoro": { "type": "number" },
        "ratingLocation": { "type": "number" },
        "ratingCommunication": { "type": "number" },
        "ratingChallenge": { "type": "number" },
        "ratingTeamwork": { "type": "number" },
        "ratingMystique": { "type": "number" },
        "ratingPrice": { "type": "number" },
        "ratingDiscussions": { "type": "number" },
        "whatLiked": { "type": "string" },
        "whatImprove": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "scoutGroup",
        "ratingSchedule",
        "ratingFood",
        "ratingCocoro",
        "ratingLocation",
        "ratingCommunication",
        "ratingChallenge",
        "ratingTeamwork",
        "ratingMystique",
        "ratingPrice",
        "ratingDiscussions",
        "createdAt"
      ]
    },
    "NewsArticle": {
      "title": "News Article",
      "description": "News posted by communications team role",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "authorName": { "type": "string" }
      },
      "required": ["title", "description", "createdAt"]
    }
  },
  "firestore": {
    "/registrations/{regId}": {
      "schema": "Registration",
      "description": "Collection of participant registrations"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Collection of payment reports"
    },
    "/config/{configId}": {
      "schema": "Config",
      "description": "Global configuration documents"
    },
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Collection of candidates printed on the ballot"
    },
    "/votes_audit/{auditId}": {
      "schema": "VoteAudit",
      "description": "Collection tracking voters who have voted"
    },
    "/votes_ballot/{ballotId}": {
      "schema": "VoteBallot",
      "description": "Collection containing anonymous votes"
    },
    "/group_attachments/{attachmentId}": {
      "schema": "GroupAttachment",
      "description": "Collection of group attachments (PDF or images)"
    },
    "/responses_questionnaire/{responseId}": {
      "schema": "QuestionnaireResponse",
      "description": "Collection of event evaluation survey answers"
    },
    "/news_articles/{articleId}": {
      "schema": "NewsArticle",
      "description": "Collection of news reports and bulletins"
    }
  }
}
